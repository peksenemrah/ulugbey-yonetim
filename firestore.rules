rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Yalnızca uygulamanın ortak hesabı (PIN ile giriş) okuyup yazabilir
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'etkinlik@ulugbey-yonetim.app';
    }
  }
}
